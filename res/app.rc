#include <winres.h>

#ifdef DEV_MANIFEST
1 RT_MANIFEST "app-dev.manifest"
#else
1 RT_MANIFEST "app.manifest"
#endif

#ifdef HAVE_ICON
1 ICON "app.ico"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Macro Tool"
      VALUE "ProductName", "Macro Tool"
      VALUE "FileVersion", "2.0.0"
      VALUE "ProductVersion", "2.0.0"
      VALUE "OriginalFilename", "MacroTool.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
